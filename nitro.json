{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrospeakerid"],
  "ios": {
    "iosModuleName": "NitroSpeakerId"
  },
  "android": {
    "androidNamespace": ["nitrospeakerid"],
    "androidCxxLibName": "NitroSpeakerId"
  },
  "autolinking": {
    "SpeakerId": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSpeakerId"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSpeakerId"
      }
    }
  },
  "ignorePaths": ["node_modules", "example", "docs"]
}
